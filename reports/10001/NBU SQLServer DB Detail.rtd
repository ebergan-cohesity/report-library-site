          <entry>
            <string>dataSource</string>
            <string>-- Author:  ernie.bergan@veritas.com&#xd;
-- Last Modified 2022/08/11&#xd;
-- Added Schedule level&#xd;
&#xd;
-- Previously Modified:  2022/05/20&#xd;
-- Added date ranging logic and additional hidden fields to help guide drilldowns&#xd;
-- Previously Modified:   2022/04/27&#xd;
--&#xd;
-- Summarizes best status achieved for MSSQL policies per user-specified time period.&#xd;
-- Default grouping is per day, based on job start time.&#xd;
-- Jobs that don&apos;t resolve to a SQL Server DB name are ignored.&#xd;
-- Order is client_name, instance name, DB name, period (date)&#xd;
--&#xd;
WITH vrs as (&#xd;
  select &apos;${instance}&apos; as the_instance,&#xd;
         &apos;${dbName}&apos; as the_DBname,&#xd;
  --       &apos;${summstatus}&apos; as the_summ_status,&#xd;
         &apos;${serverId}&apos; AS the_server,&#xd;
         &apos;${clientId}&apos; AS the_client,&#xd;
         &apos;${policies}&apos; AS the_policies&#xd;
FROM apt_v_dual&#xd;
) &#xd;
--select * from vrs&#xd;
,&#xd;
-- 1) Seed jobs strictly by requested range (do not lose these)&#xd;
jobs_seed AS (&#xd;
    SELECT /*+ MATERIALIZE */&#xd;
        server_id,&#xd;
        job_id,&#xd;
        parent_job_id,&#xd;
        policy_id,&#xd;
        policy_name,&#xd;
        job_type_name,&#xd;
        schedule_type_name,&#xd;
        summary_status,&#xd;
        vendor_status_name,&#xd;
        client_id,&#xd;
        client_host_name,&#xd;
        nbu_job_id,&#xd;
        parent_nbu_job_id,&#xd;
        start_date,&#xd;
        finish_date&#xd;
    FROM apt_v_nbu_job_detail, vrs&#xd;
    WHERE policy_type = 15&#xd;
      AND start_date BETWEEN ${startDate} AND ${endDate}&#xd;
      AND job_type NOT IN (107)&#xd;
      AND server_id = the_server&#xd;
      AND client_id = the_client&#xd;
      AND policy_id IN (${policies})&#xd;
),&#xd;
&#xd;
-- 2) Root mapping (hierarchy-safe). Scoped to same clients AND same server_ids for performance.&#xd;
seed_root AS (&#xd;
    SELECT&#xd;
        seed_job_id,&#xd;
        MAX(job_id)         KEEP (DENSE_RANK LAST ORDER BY lvl) AS root_job_id,&#xd;
        MAX(summary_status) KEEP (DENSE_RANK LAST ORDER BY lvl) AS root_summary_status,&#xd;
        MAX(start_date)     KEEP (DENSE_RANK LAST ORDER BY lvl) AS root_start,&#xd;
        MAX(finish_date)    KEEP (DENSE_RANK LAST ORDER BY lvl) AS root_finish&#xd;
    FROM (&#xd;
        SELECT&#xd;
            CONNECT_BY_ROOT d.job_id AS seed_job_id,&#xd;
            d.job_id,&#xd;
            d.summary_status,&#xd;
            d.start_date,&#xd;
            d.finish_date,&#xd;
            LEVEL AS lvl&#xd;
        FROM apt_v_nbu_job_detail d&#xd;
        WHERE d.policy_type = 15&#xd;
          AND d.client_id IN (${hosts})&#xd;
          AND d.server_id IN (SELECT DISTINCT server_id FROM jobs_seed)&#xd;
        START WITH d.job_id IN (SELECT job_id FROM jobs_seed)&#xd;
        CONNECT BY NOCYCLE PRIOR d.parent_job_id = d.job_id&#xd;
    )&#xd;
    GROUP BY seed_job_id&#xd;
),&#xd;
&#xd;
-- 3) Parse DB name from job files into ONE row per job_id (prevents row explosion)&#xd;
job_file_parse AS (&#xd;
    SELECT&#xd;
        jf.job_id,&#xd;
        MAX(parsed_db_name) KEEP (&#xd;
            DENSE_RANK FIRST&#xd;
            ORDER BY LENGTH(parsed_db_name) DESC, parsed_db_name ASC&#xd;
        ) AS parsed_db_name&#xd;
    FROM (&#xd;
        SELECT&#xd;
            jf.job_id,&#xd;
            CASE&#xd;
                WHEN jf.pathname IS NULL THEN NULL&#xd;
&#xd;
                WHEN INSTR(jf.pathname, &apos;trx&apos;) &gt; 0 THEN&#xd;
                    TRIM(&apos;/&apos; FROM TRIM(&apos;.&apos; FROM SUBSTR(jf.pathname,&#xd;
                        INSTR(jf.pathname, &apos;trx&apos;) + 3,&#xd;
                        INSTR(jf.pathname, &apos;~&apos;) - 1 - INSTR(jf.pathname, &apos;trx&apos;) - 2)))&#xd;
&#xd;
                WHEN INSTR(jf.pathname, &apos;inc&apos;) &gt; 0 THEN&#xd;
                    TRIM(&apos;/&apos; FROM TRIM(&apos;.&apos; FROM SUBSTR(jf.pathname,&#xd;
                        INSTR(jf.pathname, &apos;inc&apos;) + 3,&#xd;
                        INSTR(jf.pathname, &apos;~&apos;) - 1 - INSTR(jf.pathname, &apos;inc&apos;) - 2)))&#xd;
&#xd;
                WHEN INSTR(jf.pathname, &apos;.md.&apos;) &gt; 0 THEN&#xd;
                    TRIM(&apos;/&apos; FROM TRIM(&apos;.&apos; FROM SUBSTR(jf.pathname,&#xd;
                        INSTR(jf.pathname, &apos;.md.&apos;) + 4,&#xd;
                        INSTR(jf.pathname, &apos;~&apos;) - 1 - INSTR(jf.pathname, &apos;.md.&apos;) - 3)))&#xd;
&#xd;
                WHEN INSTR(jf.pathname, &apos;/md/&apos;) &gt; 0 THEN&#xd;
                    TRIM(&apos;/&apos; FROM TRIM(&apos;.&apos; FROM SUBSTR(jf.pathname,&#xd;
                        INSTR(jf.pathname, &apos;/md/&apos;) + 4,&#xd;
                        INSTR(jf.pathname, &apos;~&apos;) - 1 - INSTR(jf.pathname, &apos;/md/&apos;) - 3)))&#xd;
&#xd;
                WHEN INSTR(jf.pathname, &apos;.db.&apos;) &gt; 0 THEN&#xd;
                    TRIM(&apos;/&apos; FROM TRIM(&apos;.&apos; FROM SUBSTR(jf.pathname,&#xd;
                        INSTR(jf.pathname, &apos;.db.&apos;) + 4,&#xd;
                        INSTR(jf.pathname, &apos;~&apos;) - 1 - INSTR(jf.pathname, &apos;.db.&apos;) - 3)))&#xd;
&#xd;
                WHEN INSTR(jf.pathname, &apos;/db/&apos;) &gt; 0 THEN&#xd;
                    TRIM(&apos;/&apos; FROM TRIM(&apos;.&apos; FROM SUBSTR(jf.pathname,&#xd;
                        INSTR(jf.pathname, &apos;/db/&apos;) + 4,&#xd;
                        INSTR(jf.pathname, &apos;~&apos;) - 1 - INSTR(jf.pathname, &apos;/db/&apos;) - 3)))&#xd;
&#xd;
                WHEN INSTR(jf.pathname, &apos;DATABASE=\&quot;&apos;) &gt; 0&#xd;
                 AND INSTR(jf.pathname, &apos;DATABASE=\&quot;%24ALL\&quot;&apos;) = 0 THEN&#xd;
                    TRIM(&apos;/&apos; FROM TRIM(&apos;.&apos; FROM SUBSTR(jf.pathname,&#xd;
                        INSTR(jf.pathname, &apos;DATABASE=\&quot;&apos;) + 10,&#xd;
                        INSTR(jf.pathname, &apos;;TYPE=&apos;) - 1 - INSTR(jf.pathname, &apos;DATABASE=\&quot;&apos;) - 10)))&#xd;
            END AS parsed_db_name&#xd;
        FROM apt_v_nbu_job_file jf&#xd;
        JOIN jobs_seed j&#xd;
          ON j.job_id = jf.job_id&#xd;
        WHERE jf.pathname IS NOT NULL&#xd;
          AND jf.pathname &lt;&gt; &apos;AUTOMATIC_DATABASE_BACKUP&apos;&#xd;
          AND (&#xd;
                 INSTR(jf.pathname, &apos;trx&apos;) &gt; 0&#xd;
              OR INSTR(jf.pathname, &apos;inc&apos;) &gt; 0&#xd;
              OR INSTR(jf.pathname, &apos;.md.&apos;) &gt; 0&#xd;
              OR INSTR(jf.pathname, &apos;/md/&apos;) &gt; 0&#xd;
              OR INSTR(jf.pathname, &apos;.db.&apos;) &gt; 0&#xd;
              OR INSTR(jf.pathname, &apos;/db/&apos;) &gt; 0&#xd;
              OR (INSTR(jf.pathname, &apos;DATABASE=\&quot;&apos;) &gt; 0 AND INSTR(jf.pathname, &apos;DATABASE=\&quot;%24ALL\&quot;&apos;) = 0)&#xd;
          )&#xd;
    ) jf&#xd;
    WHERE parsed_db_name IS NOT NULL&#xd;
    GROUP BY job_id&#xd;
),&#xd;
&#xd;
-- 4) Policy instance fallback (can be many-per-policy; we only join when needed)&#xd;
policy_instances AS (&#xd;
    SELECT /*+ MATERIALIZE */&#xd;
        policy_id,&#xd;
        instance_name&#xd;
    FROM apt_v_nbu_policy_db_instance&#xd;
    WHERE instance_name IS NOT NULL&#xd;
    GROUP BY policy_id, instance_name&#xd;
),&#xd;
&#xd;
--5) Build the base set in ONE pass:&#xd;
--      - prefer parsed_db_name&#xd;
--      - else fall back to policy instance (only if no parsed name)&#xd;
--      - else UNKNOWN&#xd;
--&#xd;
pretime_base AS (&#xd;
    SELECT&#xd;
        j.server_id,&#xd;
        j.client_id,&#xd;
        j.client_host_name,&#xd;
        NVL(pi.instance_name, &apos;none&apos;) AS instance_name,&#xd;
        NVL(fp.parsed_db_name, NVL(pi.instance_name, &apos;UNKNOWN&apos;)) AS db_name,&#xd;
&#xd;
        j.policy_id,&#xd;
        j.policy_name,&#xd;
        j.job_type_name,&#xd;
        j.schedule_type_name,&#xd;
        j.summary_status,&#xd;
        j.vendor_status_name,&#xd;
        j.start_date,&#xd;
        j.finish_date,&#xd;
&#xd;
        sr.root_job_id,&#xd;
        sr.root_summary_status,&#xd;
        sr.root_start,&#xd;
        sr.root_finish,&#xd;
&#xd;
        TRUNC(&#xd;
            j.start_date,&#xd;
            DECODE(&apos;${freeCombo1}&apos;,&apos;Days&apos;,&apos;DD&apos;,&apos;Weeks&apos;,&apos;IW&apos;,&apos;Months&apos;,&apos;MM&apos;,&apos;Quarters&apos;,&apos;Q&apos;,&apos;Years&apos;,&apos;YYYY&apos;)&#xd;
        ) AS period&#xd;
    FROM jobs_seed j&#xd;
    LEFT JOIN seed_root sr&#xd;
      ON sr.seed_job_id = j.job_id&#xd;
    LEFT JOIN job_file_parse fp&#xd;
      ON fp.job_id = j.job_id&#xd;
    LEFT JOIN policy_instances pi&#xd;
      ON pi.policy_id = j.policy_id&#xd;
     AND fp.job_id IS NULL           -- only fallback to policy instances if no file-derived db name&#xd;
)&#xd;
select * from pretime_base, vrs&#xd;
WHERE   instance_name = the_instance&#xd;
AND     db_Name = the_DBname&#xd;
</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
